# Copy this file to .env and fill in values for your local environment.
# Never commit .env or put real credentials in this example file.
SECRET_KEY=replace-with-a-new-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL
DB_NAME=PharmaHub
DB_USER=pharma
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional AI and Google OAuth integrations
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=

# Optional SMTP/email settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Optional locale settings
TIME_ZONE=Asia/Karachi
LANGUAGE_CODE=en-us